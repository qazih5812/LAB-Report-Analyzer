# CityLab Diagnostics Medical Lab Report Explainer - Environment Configuration Template
# Copy this file to .env and insert your optional API keys.
# If no keys are provided, the system seamlessly operates on its
# certified offline deterministic rules and fallback explainer engine.

# LLM Provider Keys (Optional: Priority order: Gemini -> Groq -> OpenRouter -> Deterministic)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
